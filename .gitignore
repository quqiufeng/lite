# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex


# local secrets
.env
.env.*
!.env.example

# lite runtime / build artifacts
build/
dist/
artifacts/
cluster-out/
mem.bin
mem.idx
mem.lock
# 追踪账本快照（trace.prof 退出时落盘，运行态产物，不是真相）
prof.json

# codesearch: tokenizers-cpp 静态库随仓库自带（构建 liblite_codesearch.so 需要）
!third_party/codesearch/lib/tokenizers-cpp/*.a
# tokenizers 源码按需拉取构建，不随仓库
third_party/codesearch/.build/

# keep vendored cjson shared object
!third_party/cjson/lua/5.1/cjson.so
# ocr: 只跟 libocr_simple.so（76KB，仓库自带）。
# onnxruntime 是机器相关的大件（CPU 22MB / GPU 26MB / provider 329MB），
# 不进仓库也不进 dist：自己部署，见 README「依赖」章节
!third_party/ocr/lib/libocr_simple.so
third_party/ocr/lib/libonnxruntime*

# native helpers: 编出来的 .so 和 <name>.json 清单只有几 KB，随仓库提交，
# clone 下来直接能调（不用本机有 cc）。只有 <name>-<ts>.so 旧版本会被
# `native remove` 清掉，别手删清单——`_helper_so_abs` 靠它找 .so。
# （上面全局 `*.so` 忽略，这里给 helper/ 开口子。）
!helper/*.so

