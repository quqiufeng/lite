#!/usr/bin/env bash
# 仓库内部用的 LuaJIT 包装（run.sh / test.sh / check_deps.sh / 各 tools/*.lua）。
# 只暴露项目自身的模块与 .so 路径，不带任何 workspace 状态；
# 插件和外部脚本走 tools/lua.sh（那边才注入 cwd 与预加载）。
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
LUA="$ROOT/third_party/luajit/src/luajit"

if [ ! -x "$LUA" ]; then
    LUA="$(command -v luajit || true)"
fi
if [ -z "$LUA" ]; then
    echo "lite: bundled luajit not found" >&2
    exit 1
fi

export LITE_ROOT="$ROOT"
# 不要把 $ROOT/lib 塞进 LD_LIBRARY_PATH：
# 该变量会被 exec 出的子进程（bash 工具、native helper、外部脚本）继承，
# 而随包附带的 libonnxruntime.so.1 会遮蔽系统同名库（缺 VERS_1.20.1 等版本符号），
# 让依赖系统 onnxruntime 的工具静默失败。
# 自带 .so 一律靠 $ORIGIN RUNPATH 定位同目录依赖；例外由 FFI 层按绝对路径
# ffi.load 预加载（见 lua/ffi/ocr.lua 的 load_ort）。
#
# LUA_PATH / LUA_CPATH：项目路径在前，`;;` 展开默认路径，外部传入的追加在最后
# （tools/lua.sh 就是靠这一点把 workspace 条目挂上来的）。
export LUA_PATH="$ROOT/lua/?.lua;$ROOT/lua/?/init.lua;$ROOT/helper/?.lua;;${LUA_PATH:-}"
export LUA_CPATH="$ROOT/third_party/cjson/lua/5.1/?.so;$ROOT/build/?.so;$ROOT/lib/?.so;$ROOT/helper/?.so;;${LUA_CPATH:-}"

# 预加载只做「把调用方给的绝对路径列表 dlopen 成 RTLD_GLOBAL」，
# 列表本身由 tools/lua.sh 计算；这里没有 workspace 概念的副作用。
PRELUDE='local f = require("ffi") local l = os.getenv("LITE_PRELOAD") if l and l ~= "" then local w = os.getenv("LITE_PRELOAD_WARN") == "1" for p in l:gmatch("[^:]+") do local ok, e = pcall(f.load, p, true) if not ok and w then io.stderr:write("lite: preload failed: " .. p .. ": " .. tostring(e) .. "\n") end end end'
case "${1:-}" in
    -v|--version|-h|--help|-b) exec "$LUA" "$@" ;;
esac

# 自重启（lite 的 /reboot、reboot 工具）：main.lua 以**退出码 75** 表示「换成
# 全新进程」，这里当监督者重新拉起自己。选退出码 + 父进程，而不是让 lite 原地
# execv / 自己 fork 再自杀：
#   - execv 只换镜像，进程仍是同一个，旧 fds/线程/环境照旧；
#   - 「lite 自己 fork 新进程然后退出」在终端里**不可行**：lite 是前台作业组
#     成员，父进程一退 shell 立刻把 tty 收回，fork 出的子进程 read(0) 直接拿到
#     EOF（tmux 里实测过，不是推测）。留在原地的必须是能一直持有终端的进程，
#     也就是这个 wrapper。
# 只认 75，其它退出码原样透传 —— 测试、--once、崩溃路径完全不受影响。
export LITE_SUPERVISED=1
LITE_REBOOT_MAX="${LITE_REBOOT_MAX:-3}"
reboot_args=("$@")
child=0
# 原始 stdin 存到 fd 3：下面的子进程要以 `&` 起（见循环里的说明）。
exec 3<&0

# 信号必须转发给子进程：lite 跑在**子**进程里（不能 exec，见下），bash 收到
# SIGTERM/SIGINT/SIGHUP 默认自己就退，luajit 被 reparent 到桌面 session 继续活着。
# `serve_smoke.sh` 每次 test.sh 都 kill 这个 wrapper 才收场，于是每跑一次测试就
# 留下一个还在 listen 的孤儿 `lite serve --port 0`（实测攒到 20 个）。
forward() { [ "$child" -gt 0 ] && kill -"$1" "$child" 2>/dev/null; return 0; }
trap 'forward TERM' TERM
trap 'forward INT' INT
trap 'forward HUP' HUP
# 链计数只活在这个 wrapper 进程里，**绝不 export**：export 会漏给 lite 的所有子进程
# （bash 工具、test.sh、helper 插件），带 `LITE_REBOOT_CHAIN` 起来的下次 lite 就从
# 中间开始数，链上限提前触发（`reboot chain stops after LITE_REBOOT_MAX restarts`
# 真这么红过）。计数不需要环境变量跨进程 —— 循环就在同一个 shell 进程里。
reboot_chain=0
while :; do
    rc=0
    unset LITE_REBOOT_CHAIN
    # 必须以 `&` 起才收得到 trap（前台跑时 bash 要等命令结束才处理信号，
    # 等于不转发）；但非交互 shell 的后台作业 stdin 会被塞成 /dev/null，
    # TUI 就读不到终端了 —— 所以提前 dup 一份原始 stdin，后台命令显式接回去。
    "$LUA" -e "$PRELUDE" ${reboot_args[@]+"${reboot_args[@]}"} <&3 &
    child=$!
    wait "$child" || rc=$?
    # trapped 信号会把 wait 打断成 128+sig，此时子进程可能还在收尾；一直等到它
    # 真的消失，退出码以最后一次 wait 为准（被信号杀就是 128+sig，原样透传）。
    while kill -0 "$child" 2>/dev/null; do
        wait "$child" || rc=$?
    done
    child=0
    if [ "$rc" -ne 75 ]; then exit "$rc"; fi
    reboot_chain=$(( reboot_chain + 1 ))
    if [ "$reboot_chain" -gt "$LITE_REBOOT_MAX" ]; then
        echo "lite: reboot chain limit reached ($LITE_REBOOT_MAX)" >&2
        exit 1
    fi
    # 新进程带 --reboot 起来 → 输入框自动填「重启成功，继续工作。」再提交。
    case " ${reboot_args[*]} " in
        *" --reboot "*) ;;
        *) reboot_args+=(--reboot) ;;
    esac
done
